[llm]
# 비밀값이 아닌 LLM runtime profile입니다.
# API key는 .env 또는 실제 환경변수에만 둡니다.
runtime = "omlx"
provider = "omlx"
model = "gemma-4-26b-a4b-it-4bit"
endpoint_url = "http://127.0.0.1:8000"
chat_completions_path = "/v1/chat/completions"
timeout_seconds = 120
supports_response_format = false
# Google AI Studio/OpenAI reasoning 계열 모델을 쓸 때만 설정합니다.
# none|minimal|low|medium|high 중 provider가 지원하는 값을 사용하세요.
# reasoning_effort = "minimal"

# OpenAI API 예시:
# runtime = "openai"
# provider = "openai"
# model = "gpt-4.1-mini"
# endpoint_url = "https://api.openai.com"
# chat_completions_path = "/v1/chat/completions"
# supports_response_format = true
# reasoning_effort = "low"

# Google AI Studio OpenAI-compatible API 예시:
# runtime = "openai"
# provider = "google_ai_studio"
# model = "gemini-3.5-flash"
# endpoint_url = "https://generativelanguage.googleapis.com/v1beta/openai"
# chat_completions_path = "/chat/completions"
# supports_response_format = true
# reasoning_effort = "minimal"

# Ollama 예시:
# runtime = "ollama"
# provider = "ollama"
# model = "qwen2.5:7b-instruct"
# endpoint_url = "http://localhost:11434"

[embedding]
# 비밀값이 아닌 semantic retrieval embedding runtime profile입니다.
# sentence-transformers는 conda 환경에 직접 설치한 뒤 enabled=true로 전환합니다.
enabled = false
runtime = "local"
provider = "sentence_transformers"
model = "intfloat/multilingual-e5-small"
device = "mps"
batch_size = 32
normalize_embeddings = true
local_files_only = true

[paths]
ontology_root = "docs/ASAP_Ontology_v1"
ontology_smoke_summary_artifact = "artifacts/ontology-smoke/runtime-smoke-summary.json"
ontology_human_review_package_artifact = "artifacts/ontology-smoke/stage1-human-review-package.json"
kurly_smoke_artifact_root = "artifacts/kurly-market-smoke"
kurly_smoke_summary_artifact = "artifacts/kurly-market-smoke/runtime-smoke-summary.json"
blackboard_runs_root = "data/runs"
blackboard_schema = "docs/ASAP_Ontology_v1/linkml/generated/asap_runtime.schema.json"
dash_url_intake_artifact_root = "tmp/asap_dash_url_intake"
taric_master_table = "data/processed/TARIC/taric_master_table.csv"

[classification]
use_semantic_candidate_retrieval = true
semantic_candidate_top_k = 8
semantic_min_score = 0.0
# null이면 UI classifier가 요청한 top_k_candidates 값을 최종 후보 수로 유지합니다.
hybrid_candidate_limit = 8

[ontology_smoke]
phase_id = "stage1_classification"
top_k = 8
max_result_count = 6
cn_candidate_top_k = 5
max_product_smoke_inputs = 2
write_summary_artifact = true
run_llm_connection_smoke = false
text_preview_characters = 700
validation_issue_preview_count = 3
resource_check_preview_count = 8
max_validation_fixture_candidates = 3
stage1_backtracking_retry_attempt = 0
use_semantic_candidate_retrieval = true
semantic_candidate_top_k = 8
semantic_min_score = 0.0
hybrid_candidate_limit = 8

[kurly_smoke]
product_urls = [
  "https://www.kurly.com/goods/5037259",
  "https://www.kurlyglobal.com/products/m00000188980",
]
timeout_seconds = 60
scroll_count = 8
headless = true
run_ocr_fallback = true
max_ocr_image_count = 8
write_summary_artifact = true
log_full_result = false
max_logged_notice_options = 3
max_logged_fields_per_option = 5
max_logged_ocr_candidate_urls = 5
field_value_preview_characters = 220
ocr_text_preview_characters = 500
