# LLM runtime API settings
#
# The bridge treats every runtime as an API endpoint:
#   omlx   -> OpenAI-compatible local HTTP API
#   ollama -> Ollama local HTTP API
#   openai -> OpenAI API or Google AI Studio OpenAI-compatible API

# Choose one: omlx, ollama, openai
EU_EXPORT_LLM_RUNTIME=omlx

# Common settings used by all runtimes
EU_EXPORT_LLM_MODEL=gemma-4-26b-a4b-it-4bit
EU_EXPORT_LLM_ENDPOINT_URL=http://localhost:8000/v1
EU_EXPORT_LLM_API_KEY=
EU_EXPORT_LLM_TIMEOUT_SECONDS=120

# OpenAI-compatible chat runtimes only.
# oMLX and OpenAI normally use /v1/chat/completions.
# Google AI Studio OpenAI-compatible endpoint normally uses /chat/completions.
EU_EXPORT_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions

# Set true only when the target runtime supports OpenAI response_format.
# OpenAI API normally supports it. Some local OpenAI-compatible servers do not.
# Ollama JSON mode is handled separately by its own API payload.
EU_EXPORT_LLM_SUPPORTS_RESPONSE_FORMAT=false

# ---------------------------------------------------------------------------
# Example: local oMLX OpenAI-compatible server
# ---------------------------------------------------------------------------
# EU_EXPORT_LLM_RUNTIME=omlx
# EU_EXPORT_LLM_MODEL=gemma-4-26b-a4b-it-4bit
# EU_EXPORT_LLM_ENDPOINT_URL=http://localhost:8000/v1
# EU_EXPORT_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# EU_EXPORT_LLM_SUPPORTS_RESPONSE_FORMAT=false

# ---------------------------------------------------------------------------
# Example: local Ollama server
# ---------------------------------------------------------------------------
# EU_EXPORT_LLM_RUNTIME=ollama
# EU_EXPORT_LLM_MODEL=qwen2.5:7b-instruct
# EU_EXPORT_LLM_ENDPOINT_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Example: OpenAI API
# ---------------------------------------------------------------------------
# EU_EXPORT_LLM_RUNTIME=openai
# EU_EXPORT_LLM_PROVIDER=openai
# EU_EXPORT_LLM_MODEL=gpt-4.1-mini
# EU_EXPORT_LLM_ENDPOINT_URL=https://api.openai.com
# EU_EXPORT_LLM_API_KEY=sk-...
# EU_EXPORT_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# EU_EXPORT_LLM_SUPPORTS_RESPONSE_FORMAT=true

# ---------------------------------------------------------------------------
# Example: Google AI Studio through OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# EU_EXPORT_LLM_RUNTIME=openai
# EU_EXPORT_LLM_PROVIDER=google_ai_studio
# EU_EXPORT_LLM_MODEL=gemini-2.0-flash
# EU_EXPORT_LLM_ENDPOINT_URL=https://generativelanguage.googleapis.com/v1beta/openai
# EU_EXPORT_LLM_API_KEY=...
# EU_EXPORT_LLM_CHAT_COMPLETIONS_PATH=/chat/completions
# EU_EXPORT_LLM_SUPPORTS_RESPONSE_FORMAT=false

# Legacy aliases are still accepted as fallbacks:
#   EU_EXPORT_OMLX_ENDPOINT_URL
#   EU_EXPORT_OLLAMA_ENDPOINT_URL
#   EU_EXPORT_OPENAI_API_KEY
#   EU_EXPORT_OPENAI_MODEL
#   EU_EXPORT_OPENAI_ENDPOINT_URL
#   EU_EXPORT_GOOGLE_AI_STUDIO_API_KEY
#   EU_EXPORT_GOOGLE_AI_STUDIO_MODEL
#   EU_EXPORT_GOOGLE_AI_STUDIO_ENDPOINT_URL
#   OPENAI_API_KEY
#   GEMINI_API_KEY

# Ontology smoke runtime call
# false: build/validate request payloads only.
# true: call the configured LLM runtime from ontology_smoke.py Stage 7.
EU_EXPORT_ONTOLOGY_SMOKE_RUN_LLM=false
