# Secret values and optional environment overrides
#
# 비밀값이 아닌 LLM runtime profile은 .appconfig.example을 참고합니다.
# .env에는 API key처럼 commit하면 안 되는 값만 두는 것을 권장합니다.
# 환경변수 값은 .appconfig보다 우선합니다.

# OpenAI, Google AI Studio, 또는 OpenAI-compatible runtime API key.
# 로컬 oMLX/Ollama에서 key가 필요 없으면 비워둡니다.
EU_EXPORT_LLM_API_KEY=

# Provider-specific aliases are still accepted as fallbacks.
EU_EXPORT_OPENAI_API_KEY=
EU_EXPORT_GOOGLE_AI_STUDIO_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides for .appconfig values. Normally leave these commented.
# EU_EXPORT_LLM_RUNTIME=omlx
# EU_EXPORT_LLM_PROVIDER=omlx
# EU_EXPORT_LLM_MODEL=gemma-4-26b-a4b-it-4bit
# EU_EXPORT_LLM_ENDPOINT_URL=http://127.0.0.1:8000
# EU_EXPORT_LLM_CHAT_COMPLETIONS_PATH=/v1/chat/completions
# EU_EXPORT_LLM_TIMEOUT_SECONDS=120
# EU_EXPORT_LLM_SUPPORTS_RESPONSE_FORMAT=false
