# Copy this file to .env and fill only the providers you use.
# Never commit real API keys.

# Default profile key used by [llm].
EU_EXPORT_DEFAULT_LLM_API_KEY=

# Dedicated keys referenced by [llm_profiles.*].api_key_env.
EU_EXPORT_PRODUCT_VLM_API_KEY=
EU_EXPORT_INPUT_RECONSTRUCTION_API_KEY=
EU_EXPORT_IDENTITY_HINT_API_KEY=
EU_EXPORT_CLASSIFICATION_SELECTOR_API_KEY=
EU_EXPORT_CLASSIFICATION_VALIDATOR_API_KEY=
EU_EXPORT_CN_PREDICATE_COMPILER_API_KEY=

# Optional provider-wide fallback keys for legacy/default configuration.
EU_EXPORT_OPENAI_API_KEY=
EU_EXPORT_GOOGLE_AI_STUDIO_API_KEY=
EU_EXPORT_ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional classification behavior. The selector is disabled unless enabled.
ASAP_STAGED_USE_LLM_SELECT=0
ASAP_STAGED_VALIDATOR=1
