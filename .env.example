# Secret values only.
#
# 비밀값이 아닌 runtime/provider/model/endpoint 설정은 .appconfig.example을 참고합니다.
# .env에는 commit하면 안 되는 API key 같은 값만 둡니다.

# Hosted LLM API key.
# OpenAI, Google AI Studio, OpenAI-compatible hosted API 모두 이 필드 하나를 사용합니다.
# 로컬 oMLX/Ollama에서 key가 필요 없으면 비워둡니다.
EU_EXPORT_LLM_API_KEY=

# Supabase/Postgres connection for document package resolution.
# Use either ASAP_DATABASE_URL (preferred) or the PG* variables below.
# Never commit the real password.
#
# Example:
# ASAP_DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<HOST>:5432/postgres?sslmode=require
ASAP_DATABASE_URL=
ASAP_DB_SOURCE_NAME=supabase
ASAP_DB_POOL_MAX_CONNECTIONS=4
ASAP_DB_POOL_SIZE=4
ASAP_DB_MAX_OVERFLOW=8
ASAP_DB_POOL_TIMEOUT_SECONDS=30
ASAP_DB_CONNECT_TIMEOUT_SECONDS=10
ASAP_DB_QUERY_QUEUE_SIZE=8

# Alternative libpq-style configuration:
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGPASSWORD=
PGSSLMODE=require
